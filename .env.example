# ============================================================
# Variables de entorno para Tu Mejor Versión
# Copia este archivo como .env y configura los valores reales
# ============================================================

# ── Configuración de la aplicación ──
APP_NAME="Tu Mejor Versión"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-mejor-version.up.railway.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ── Logs ──
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de datos MySQL (Railway provee DATABASE_URL automáticamente) ──
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tu_mejor_version
DB_USERNAME=root
DB_PASSWORD=

# ── Sesiones y caché via Redis ──
# Railway provee REDIS_URL automáticamente al añadir el servicio Redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Filesystem ──
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# ── IA: MiniMax (primario) ──
# Obtén tu key en: https://www.minimaxi.chat
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1

# ── IA: Anthropic Claude Haiku (fallback 1) ──
# Obtén tu key en: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── IA: Google Gemini Flash (fallback 2) ──
# Obtén tu key en: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Mail (opcional, para recuperación de contraseña) ──
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@tumejorversion.app"
MAIL_FROM_NAME="${APP_NAME}"

# ── Vite (frontend) ──
VITE_APP_NAME="${APP_NAME}"
